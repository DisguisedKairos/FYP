PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# npm run db:setup replaces this with a generated restricted login.
DATABASE_URL=postgresql://greenlink_app:run-db-setup@127.0.0.1:55432/greenlink_dft
SEED_DEMO=false
# npm run setup generates these in ignored .env. Never commit real values.
SERVICE_TOKEN=
AUTH_ENCRYPTION_KEY=
FRAUD_HOST=127.0.0.1
FRAUD_PORT=4011
FRAUD_SERVICE_URL=http://127.0.0.1:4011
# Optional interpreter, normally discovered in .venv automatically.
# PYTHON=C:\path\to\project\.venv\Scripts\python.exe
# JOB_INTERVAL_MS=2000
# Leave unset for direct local use. DIT integration must name only trusted IP/CIDR.
# TRUST_PROXY=127.0.0.1/32
# Native PostgreSQL tools for the optional project-owned local cluster.
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
# LOCAL_DATABASE_PORT=55432
# Keep ADMIN_DATABASE_URL and MIGRATION_DATABASE_URL in .env.database-admin.
# Keep TEST_DATABASE_URL in .env.test, never in the web application's .env.
# Optional private model-directed agent. Offline evidence workflows need no model.
AGENT_MODE=workflow
# AGENT_MODE=ollama
# AGENT_MODEL=qwen3.5:4b
# AGENT_OLLAMA_URL=http://127.0.0.1:11434
