PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set to false before the first run to start with an empty database.
SEED_DEMO=true
# Optional for npm start (generated in memory when omitted).
# Required for Docker Compose; npm run setup generates an ignored .env value.
# SERVICE_TOKEN=replace-with-at-least-32-random-characters
# INTERNAL_BASE_PORT=4010
# JOB_INTERVAL_MS=2000
# Set only when serving behind your trusted HTTPS reverse proxy.
# Must be exactly your public HTTPS origin (no path). Enables Secure cookies.
# PUBLIC_ORIGIN=https://bank.example.com
# GREENLINK_DOMAIN=bank.example.com
