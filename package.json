{
  "name": "greenlink-digital-bank",
  "version": "2.3.0",
  "private": true,
  "description": "Republic Polytechnic C300 business banking prototype based on Green Link Digital Bank, using Express, PostgreSQL and private FastAPI fraud scoring.",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-platform.js",
    "start:banking": "node --env-file-if-exists=.env app.js",
    "dev": "node --env-file-if-exists=.env scripts/start-platform.js",
    "setup": "node scripts/setup.js",
    "test": "node --env-file-if-exists=.env.test --test tests/dft-*.test.js",
    "test:browser": "node --env-file-if-exists=.env.test --test tests/browser.e2e.js tests/dft-security-browser.js",
    "train:fraud": "node scripts/train-fraud.js",
    "package": "node scripts/package.js",
    "package:verify": "node scripts/verify-package.js",
    "admin:grant": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin scripts/manage-admin.js",
    "admin:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin scripts/create-staff.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin scripts/seed-demo.js",
    "db:import-sqlite": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin scripts/import-sqlite.js",
    "start:fraud": "python -m uvicorn main:app --host 127.0.0.1 --port 4011",
    "test:python": "python -m unittest discover -s tests_python -v",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.database-admin database/setup.js",
    "db:check": "node --env-file-if-exists=.env database/check.js",
    "db:start": "node --env-file-if-exists=.env database/local.js start",
    "db:stop": "node --env-file-if-exists=.env database/local.js stop",
    "db:status": "node --env-file-if-exists=.env database/local.js status",
    "demo:fraud": "node --env-file-if-exists=.env --env-file-if-exists=.env.test scripts/demo-fraud.js",
    "demo:fraud:serve": "node --env-file-if-exists=.env --env-file-if-exists=.env.test scripts/demo-fraud.js --serve"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
