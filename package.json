{
  "name": "greenlink-digital-bank",
  "version": "1.1.0",
  "private": true,
  "description": "Greenlink Digital Bank with a private assistant, explainable fraud scoring and containerized banking services.",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-platform.js",
    "start:banking": "node --env-file-if-exists=.env app.js",
    "dev": "node --env-file-if-exists=.env scripts/start-platform.js",
    "setup": "node scripts/setup.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.e2e.js",
    "train:fraud": "node scripts/train-fraud.js",
    "package": "node scripts/package.js",
    "package:verify": "node scripts/verify-package.js",
    "admin:grant": "node --env-file-if-exists=.env scripts/manage-admin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED"
}
