{
  "name": "evergreen-banking",
  "version": "1.0.0",
  "private": true,
  "description": "An event-driven banking platform with explainable fraud scoring, scheduling, and containerized services.",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start-platform.js",
    "start:banking": "node --env-file-if-exists=.env app.js",
    "dev": "node --env-file-if-exists=.env scripts/start-platform.js",
    "setup": "node scripts/setup.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.e2e.js",
    "train:fraud": "node scripts/train-fraud.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
