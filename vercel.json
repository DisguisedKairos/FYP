{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "banking": {
      "root": ".",
      "framework": "express",
      "entrypoint": "app.js",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "functions": {
        "app.js": {
          "maxDuration": 300,
          "includeFiles": "{views/**,database/migrations/**}"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "fraud",
          "format": "url",
          "env": "FRAUD_SERVICE_BINDING_URL"
        }
      ]
    },
    "fraud": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "python -m compileall -q main.py fraud_service",
      "functions": {
        "main.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "banking"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/run",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/(.*)$",
      "transforms": [
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "X-Content-Type-Options"
          },
          "args": "nosniff"
        },
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "X-Frame-Options"
          },
          "args": "DENY"
        },
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "Referrer-Policy"
          },
          "args": "same-origin"
        },
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "Permissions-Policy"
          },
          "args": "camera=(), microphone=(), geolocation=()"
        },
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "Content-Security-Policy"
          },
          "args": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ],
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "destination": {
        "service": "banking"
      }
    }
  ]
}
